# Herdr.app terminal configuration.
# The app sets XDG_CONFIG_HOME to a dedicated Herdr-only directory.
# NO_COLOR is unset inside the launch command: Ghostty's own `env` setting only
# adds variables to the inherited environment, so it cannot clear an inherited
# one, and a stale value would strip color from Claude and other terminal apps.
command = /bin/zsh -l -c 'unset NO_COLOR; exec herdr'
auto-update = off

# @PREFIX@ is Herdr's prefix key as a control byte and @CYCLE_*@ are the keys
# it binds pane cycling to, both read from Herdr's own config at build time.
# macOS shortcuts adapted from https://venabl.es/herdr-macos-shortcuts for Herdr 0.7.5.
keybind = cmd+t=text:@PREFIX@c
keybind = cmd+n=text:@PREFIX@N
keybind = cmd+KeyW=text:@PREFIX@x
keybind = cmd+w=unbind
keybind = cmd+shift+KeyW=text:@PREFIX@X
keybind = cmd+shift+w=unbind
keybind = cmd+KeyR=text:@PREFIX@T
keybind = cmd+r=unbind
keybind = cmd+shift+KeyR=text:@PREFIX@W
keybind = cmd+shift+r=unbind
keybind = cmd+KeyD=text:@PREFIX@v
keybind = cmd+d=unbind
keybind = cmd+shift+KeyD=text:@PREFIX@-
keybind = cmd+shift+d=unbind
keybind = cmd+shift+enter=text:@PREFIX@z
keybind = cmd+alt+KeyH=text:@PREFIX@h
keybind = cmd+alt+KeyJ=text:@PREFIX@j
keybind = cmd+alt+KeyK=text:@PREFIX@k
keybind = cmd+alt+KeyL=text:@PREFIX@l
keybind = cmd+left_bracket=text:@PREFIX@@CYCLE_PREV@
keybind = cmd+right_bracket=text:@PREFIX@@CYCLE_NEXT@
keybind = cmd+physical:one=text:@PREFIX@1
keybind = cmd+1=text:@PREFIX@1
keybind = cmd+physical:two=text:@PREFIX@2
keybind = cmd+2=text:@PREFIX@2
keybind = cmd+physical:three=text:@PREFIX@3
keybind = cmd+3=text:@PREFIX@3
keybind = cmd+physical:four=text:@PREFIX@4
keybind = cmd+4=text:@PREFIX@4
keybind = cmd+physical:five=text:@PREFIX@5
keybind = cmd+5=text:@PREFIX@5
keybind = cmd+physical:six=text:@PREFIX@6
keybind = cmd+6=text:@PREFIX@6
keybind = cmd+physical:seven=text:@PREFIX@7
keybind = cmd+7=text:@PREFIX@7
keybind = cmd+physical:eight=text:@PREFIX@8
keybind = cmd+8=text:@PREFIX@8
keybind = cmd+physical:nine=text:@PREFIX@9
keybind = cmd+9=text:@PREFIX@9
